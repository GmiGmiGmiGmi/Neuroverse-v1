# Netlify / production runtime configuration
NEUROVERSE_ENV=production
CONTENT_PROVIDER=local
AUTH_PROVIDER=none
MEDIA_PROVIDER=local
ROUTING_MODE=hash
FALLBACK_TO_LOCAL=true

# Add these when switching to Supabase
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_MEDIA_BUCKET=support-media
FEATURE_ADMIN=false

# Add later only if media moves to AWS/CloudFront
AWS_PUBLIC_BASE_URL=
